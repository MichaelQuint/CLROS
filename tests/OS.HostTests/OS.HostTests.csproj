<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- Parse source dependencies with the installed compiler; no additional package. -->
		<Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.dll" />
		<Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll" />
		<!-- Keep capture projects unchanged; only this harness dispatches fixtures explicitly. -->
		<Using Include="HostFixtureAttribute" Alias="ModuleInitializerAttribute" />
		<EmbeddedResource Include="HostSourceChecks.txt" />
		<ProjectReference Include="..\..\src\OS.Kernel\OS.Kernel.csproj" />
		<ProjectReference Include="..\..\std\no-runtime\shared\OS.Std.NoRuntime.Shared.csproj" />
		<ProjectReference Include="..\..\tools\OS.ImageBuilder\OS.ImageBuilder.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\..\tools\OS.LibvirtRunner\OS.LibvirtRunner.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\..\tools\OS.ManifestTool\OS.ManifestTool.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\..\tools\OS.QemuRunner\OS.QemuRunner.csproj" />
	</ItemGroup>

	<!-- Bind execution without rebuilding to the source actually compiled, without putting the whole
	     host assembly hash into every fixture's resume key. -->
	<Target Name="RecordHostCompiledInputs" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'OS.HostTests'">
		<ItemGroup>
			<HostReferenceInputs Include="..\..\src\OS.Kernel\**\*.cs;..\..\std\no-runtime\shared\**\*.cs;..\..\tools\OS.ImageBuilder\**\*.cs;..\..\tools\OS.LibvirtRunner\**\*.cs;..\..\tools\OS.ManifestTool\**\*.cs;..\..\tools\OS.QemuRunner\**\*.cs" Exclude="..\..\**\obj\**;..\..\**\bin\**" />
			<HostReferenceInputs Include="@(ProjectReference);..\..\Directory.Build.*;..\..\tools\Directory.Build.*;..\..\global.json;@(ReferenceCopyLocalPaths)" />
			<HostReferenceInputs Include="..\..\tools\OS.ImageBuilder\bin\$(Configuration)\net10.0\OS.ImageBuilder.dll;..\..\tools\OS.LibvirtRunner\bin\$(Configuration)\net10.0\OS.LibvirtRunner.dll;..\..\tools\OS.ManifestTool\bin\$(Configuration)\net10.0\OS.ManifestTool.dll" />
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)OS.HostTests.options.txt" Lines="$(Configuration)|$(TargetFramework)|$(LangVersion)|$(DefineConstants)|$(Optimize)|$(PlatformTarget)|$(AllowUnsafeBlocks)|$(CheckForOverflowUnderflow)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<GetFileHash Files="@(Compile);@(HostReferenceInputs);$(TargetPath);$(MSBuildProjectFullPath);HostSourceChecks.txt;$(TargetDir)OS.HostTests.options.txt" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="HostCompiledInputs" />
		</GetFileHash>
		<WriteLinesToFile File="$(TargetDir)OS.HostTests.inputs.sha256" Lines="@(HostCompiledInputs->'%(FullPath)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
	</Target>

</Project>
