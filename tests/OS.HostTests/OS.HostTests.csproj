  <!-- Resolve after SDK targets assign RoslynTargetsPath. Visual Studio selects
       Roslyn/binfx; dotnet MSBuild selects Roslyn. Both use SDK bincore here. -->
  <Target Name="ResolveHostTestRoslynReferences" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <HostTestRoslynDirectory>$(RoslynTargetsPath)/bincore</HostTestRoslynDirectory>
      <HostTestRoslynDirectory Condition="!Exists('$(HostTestRoslynDirectory)/Microsoft.CodeAnalysis.dll')">$(RoslynTargetsPath)/../bincore</HostTestRoslynDirectory>
    </PropertyGroup>
    <ItemGroup>
      <Reference Include="Microsoft.CodeAnalysis" HintPath="$(HostTestRoslynDirectory)/Microsoft.CodeAnalysis.dll" />
      <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(HostTestRoslynDirectory)/Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
  </Target>

  <Target Name="CaptureHostTestBuildInputs" BeforeTargets="AssignTargetPaths" DependsOnTargets="CaptureHostProjectOutputs;ResolveReferences;GenerateGlobalUsings;GenerateTargetFrameworkMonikerAttribute;GenerateAssemblyInfo">
    <PropertyGroup>
      <!-- Normalize before globbing: parent segments can prevent generated-tree exclusions from matching. -->
      <_HostTestSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</_HostTestSourceRoot>
    </PropertyGroup>
    <ItemGroup>
      <_HostTestInput Include="@(Compile);@(ReferencePath);$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)..\..\global.json;$(MSBuildThisFileDirectory)..\..\CLROS.slnx;$(MSBuildThisFileDirectory)..\..\Directory.Build.props;$(MSBuildThisFileDirectory)..\..\Directory.Build.targets;$(MSBuildThisFileDirectory)..\..\.editorconfig;$(MSBuildThisFileDirectory)..\..\.gitea\backlog\clros-issues.json" />
      <_HostTestInput Include="$(_HostTestSourceRoot)apps\**\*.cs;$(_HostTestSourceRoot)apps\**\*.csproj;$(_HostTestSourceRoot)apps\**\*.props;$(_HostTestSourceRoot)apps\**\*.targets;$(_HostTestSourceRoot)apps\**\*.json"
        Exclude="$(_HostTestSourceRoot)**\obj\**\*;$(_HostTestSourceRoot)**\bin\**\*;$(_HostTestSourceRoot)**\artifacts\**\*" />
      <_HostTestInput Include="$(_HostTestSourceRoot)src\**\*.cs;$(_HostTestSourceRoot)src\**\*.csproj;$(_HostTestSourceRoot)std\**\*.cs;$(_HostTestSourceRoot)std\**\*.csproj;$(_HostTestSourceRoot)tools\**\*.cs;$(_HostTestSourceRoot)tools\**\*.csproj;$(_HostTestSourceRoot)tests\**\*.cs;$(_HostTestSourceRoot)tests\**\*.csproj"
        Exclude="$(_HostTestSourceRoot)**\obj\**\*;$(_HostTestSourceRoot)**\bin\**\*;$(_HostTestSourceRoot)**\artifacts\**\*" />
      <_HostTestInput Include="$(_HostTestSourceRoot)src\**\*.props;$(_HostTestSourceRoot)src\**\*.targets;$(_HostTestSourceRoot)std\**\*.props;$(_HostTestSourceRoot)std\**\*.targets;$(_HostTestSourceRoot)tools\**\*.props;$(_HostTestSourceRoot)tools\**\*.targets;$(_HostTestSourceRoot)tests\**\*.props;$(_HostTestSourceRoot)tests\**\*.targets;$(_HostTestSourceRoot)scripts\*.ps1;$(_HostTestSourceRoot).gitea\workflows\*.yml"
        Exclude="$(_HostTestSourceRoot)**\obj\**\*;$(_HostTestSourceRoot)**\bin\**\*;$(_HostTestSourceRoot)**\artifacts\**\*" />
    </ItemGroup>
    <GetFileHash Files="@(_HostTestInput)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HostTestInputHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)host-test-inputs.txt"
      Lines="@(_HostTestInputHash->'%(FullPath)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)host-test-inputs.txt" LogicalName="host-test-inputs.txt" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)host-test-options.txt"
      Lines="$(Configuration)|$(TargetFramework)|$(RuntimeIdentifier)|$(LangVersion)|$(DefineConstants)|$(Optimize)|$(CheckForOverflowUnderflow)|$(AllowUnsafeBlocks)|$(Nullable)|$(PlatformTarget)"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)host-test-options.txt" LogicalName="host-test-options.txt" />
    </ItemGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../tools/OS.CompilerReceipts/HostProjectOutputs.targets" Condition="'$(_ClrosHostProjectOutputsImported)' != 'true'" />
