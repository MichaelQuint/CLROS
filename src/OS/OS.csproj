	<Target Name="CustomizeReferences"
			BeforeTargets="BeforeCompile"
			AfterTargets="FindReferenceAssembliesForReferences">
		<ItemGroup>
			<ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
			<ReferencePath Remove="@(ReferencePath)" />
		</ItemGroup>
	</Target>

	<Target Name="RemoveHostConfigurationOptions"
			BeforeTargets="WriteIlcRspFileForCompilation"
			DependsOnTargets="PrepareForILLink">
		<ItemGroup>
			<RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
		</ItemGroup>
	</Target>

	<Target Name="RemoveEfiExports"
			BeforeTargets="WriteIlcRspFileForCompilation;LinkNative">
		<PropertyGroup>
			<ExportsFile></ExportsFile>
		</PropertyGroup>
	</Target>

	<Target Name="RemoveNativeAotRuntimeLibraries"
			AfterTargets="SetupOSSpecificProps"
			BeforeTargets="LinkNative">
		<ItemGroup>
			<NativeLibrary Remove="@(NativeLibrary)" />
			<NetCoreAppNativeLibrary Remove="@(NetCoreAppNativeLibrary)" />
			<SdkNativeLibrary Remove="@(SdkNativeLibrary)" />
			<DirectPInvoke Remove="@(DirectPInvoke)" />
			<DirectPInvokeList Remove="@(DirectPInvokeList)" />
			<LinkerArg Remove="@(LinkerArg)" />
			<LinkerArg Include="/NOLOGO" />
			<LinkerArg Include="/MANIFEST:NO" />
			<LinkerArg Include="/INCREMENTAL:NO" />
			<LinkerArg Include="/BREPRO" />
			<LinkerArg Include="/SUBSYSTEM:$(LinkerSubsystem)" />
			<LinkerArg Include="/ENTRY:$(EntryPointSymbol)" />
			<LinkerArg Include="/NODEFAULTLIB" />
			<LinkerArg Include="/OPT:REF" />
			<LinkerArg Include="/OPT:ICF" />
		</ItemGroup>
	</Target>

