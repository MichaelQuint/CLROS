<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="QemuContracts.cs" />
    <Compile Remove="NativeFile.cs" />
    <Compile Remove="NativeFile.FileIdentity.cs" />
    <Compile Remove="NativeFile.FILETIME.cs" />
    <Compile Remove="NativeFile.BY_HANDLE_FILE_INFORMATION.cs" />
    <Compile Remove="NativeFile.LinuxStat.cs" />
    <ProjectReference Include="..\OS.LibvirtRunner\OS.LibvirtRunner.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\OS.QemuRunner\OS.QemuRunner.csproj" />
    <ProjectReference Include="..\OS.X64TextSerializerGenerator\OS.X64TextSerializerGenerator.csproj" />
    <ProjectReference Include="..\OS.QemuCapture\OS.QemuCapture.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\OS.ImageBuilder\OS.ImageBuilder.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\OS.ManifestTool\OS.ManifestTool.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <!-- Roslyn runs only in this host tool. No analyzer or framework reference
       is added to the freestanding EFI compilation. -->
  <Target Name="ResolveToolingRoslynReferences" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <ToolingRoslynDirectory>$(RoslynTargetsPath)/bincore</ToolingRoslynDirectory>
      <ToolingRoslynDirectory Condition="!Exists('$(ToolingRoslynDirectory)/Microsoft.CodeAnalysis.dll')">$(RoslynTargetsPath)/../bincore</ToolingRoslynDirectory>
    </PropertyGroup>
    <ItemGroup>
      <Reference Include="Microsoft.CodeAnalysis" HintPath="$(ToolingRoslynDirectory)/Microsoft.CodeAnalysis.dll" />
      <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(ToolingRoslynDirectory)/Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
  </Target>
  <!-- This inventory is embedded with the hashes. Runtime discovery consumes
       these same patterns, so adding a source never escapes a no-build check. -->
  <PropertyGroup>
    <_ToolingRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..'))</_ToolingRepositoryRoot>
    <_ToolingInputPatterns>tools/**/*.cs;tools/**/*.csproj;tools/**/*.props;tools/**/*.targets;src/OS.Kernel/**/*.cs;src/OS.Kernel/**/*.csproj;src/OS.Kernel/**/*.props;src/OS.Kernel/**/*.targets;src/OS.Std.NoRuntime.Shared/**/*.cs;src/OS.Std.NoRuntime.Shared/**/*.csproj;src/OS.Std.NoRuntime.Shared/**/*.props;src/OS.Std.NoRuntime.Shared/**/*.targets;std/**/*.cs;std/**/*.csproj;std/**/*.props;std/**/*.targets;CLROS.slnx;global.json;Directory.Build.props;Directory.Build.targets;.editorconfig</_ToolingInputPatterns>
    <_ToolingAbsolutePatterns>$(_ToolingRepositoryRoot)$(_ToolingInputPatterns.Replace(';', ';$(_ToolingRepositoryRoot)'))</_ToolingAbsolutePatterns>
    <_ToolingManifestPatterns>GLOB|$(_ToolingInputPatterns.Replace(';', ';GLOB|'))</_ToolingManifestPatterns>
  </PropertyGroup>
  <Target Name="CaptureToolingBuildInputs" BeforeTargets="AssignTargetPaths" DependsOnTargets="CaptureHostProjectOutputs;ResolveReferences">
    <ItemGroup>
      <_ToolingInput Include="$([MSBuild]::Unescape('$(_ToolingAbsolutePatterns)'))"
        Exclude="$(_ToolingRepositoryRoot)**/bin/**;$(_ToolingRepositoryRoot)**/obj/**;$(_ToolingRepositoryRoot)**/artifacts/**" />
    </ItemGroup>
    <GetFileHash Files="@(_ToolingInput)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ToolingInputHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)tooling-build-inputs.txt"
      Lines="CLROS_BUILD_INPUTS_V1;ROOT|$(_ToolingRepositoryRoot);$([MSBuild]::Unescape('$(_ToolingManifestPatterns)'));@(_ToolingInputHash->'FILE|%(FullPath)|%(FileHash)')"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)tooling-build-inputs.txt" LogicalName="tooling-build-inputs.txt" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../OS.CompilerReceipts/HostProjectOutputs.targets" Condition="'$(_ClrosHostProjectOutputsImported)' != 'true'" />
  <Import Project="../OS.CompilerReceipts/HostCompilationReceipts.targets" />
</Project>
