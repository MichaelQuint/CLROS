<Project>

  <PropertyGroup>
    <_ClrosX64SerializerGeneratorDirectory>$(MSBuildThisFileDirectory)</_ClrosX64SerializerGeneratorDirectory>
    <_ClrosX64SerializerGeneratorProject>$(_ClrosX64SerializerGeneratorDirectory)OS.X64TextSerializerGenerator.csproj</_ClrosX64SerializerGeneratorProject>
    <_ClrosX64SerializerCanonicalToolsProps>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Directory.Build.props'))</_ClrosX64SerializerCanonicalToolsProps>
    <_ClrosX64SerializerCanonicalRootTargets>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Directory.Build.targets'))</_ClrosX64SerializerCanonicalRootTargets>
    <_ClrosX64SerializerObjectName>CLROS.X64.InstructionPublication.obj</_ClrosX64SerializerObjectName>
    <_ClrosCheckedReferenceObjectName>CLROS.X64.CheckedReferenceBarriers.obj</_ClrosCheckedReferenceObjectName>
    <_ClrosInterfaceDispatchObjectName>CLROS.X64.InterfaceDispatch.obj</_ClrosInterfaceDispatchObjectName>
    <_ClrosSimpleCatchObjectName>CLROS.X64.SimpleThrowCatch.obj</_ClrosSimpleCatchObjectName>
    <_ClrosSingleFinallyObjectName>CLROS.X64.SingleFinallyCatch.obj</_ClrosSingleFinallyObjectName>
    <_ClrosNestedFinallyObjectName>CLROS.X64.NestedFinallyCatch.obj</_ClrosNestedFinallyObjectName>
    <_ClrosFrameDispatchObjectName>CLROS.X64.FrameDispatch.obj</_ClrosFrameDispatchObjectName>
    <_ClrosConstructorFailureObjectName>CLROS.X64.ConstructorFailure.obj</_ClrosConstructorFailureObjectName>
    <_ClrosFilteredCatchObjectName>CLROS.X64.FilteredCatch.obj</_ClrosFilteredCatchObjectName>
    <_ClrosFilterInvokeObjectName>CLROS.X64.FilterInvoke.obj</_ClrosFilterInvokeObjectName>
    <_ClrosRethrowOuterObjectName>CLROS.X64.RethrowOuter.obj</_ClrosRethrowOuterObjectName>
    <_ClrosRethrowInnerObjectName>CLROS.X64.RethrowInner.obj</_ClrosRethrowInnerObjectName>
    <_ClrosX64SerializerCanonicalSdkDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\.'))</_ClrosX64SerializerCanonicalSdkDirectory>
    <_ClrosX64SerializerCanonicalSdksPath>$([System.IO.Path]::GetFullPath('$(_ClrosX64SerializerCanonicalSdkDirectory)\Sdks'))</_ClrosX64SerializerCanonicalSdksPath>
    <_ClrosX64SerializerCanonicalMsbuildExtensionsPath>$(_ClrosX64SerializerCanonicalSdkDirectory)\</_ClrosX64SerializerCanonicalMsbuildExtensionsPath>
    <_ClrosX64SerializerCanonicalDisabledUserExtensions>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)disabled-user-extensions'))</_ClrosX64SerializerCanonicalDisabledUserExtensions>
    <ClrosX64InstructionPublicationSymbol>CLROS_X64_SerializeInstructionPublication</ClrosX64InstructionPublicationSymbol>
    <ClrosX64InstructionPublicationObjectBytes>336</ClrosX64InstructionPublicationObjectBytes>
    <ClrosX64InstructionPublicationObjectSha256>DA97E50C95E479541B65EB3F96D9C6DED163735857650BEE9416324086D55C7B</ClrosX64InstructionPublicationObjectSha256>
  </PropertyGroup>

  <ItemGroup>
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorProject)" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.Amd64CoffObjectDefinition.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.CoffRelocationDefinition.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.CoffSectionDefinition.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.CoffSectionLayout.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.CoffSymbolDefinition.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.CoffWriteError.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.CoffWritePlan.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Amd64CoffWriter.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)CheckedReferenceBarrierThunkGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)EhContributionCatalogGenerator.Contribution.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)EhContributionCatalogGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)EhContributionCatalogGenerator.Node.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)EhContributionCatalogGenerator.Symbol.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)ExceptionFilterThunkGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)ExceptionHandlingThunkGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)InstructionPublicationSerializerGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)InterfaceDispatchThunkGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)NormalFinallyThunkGenerator.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Program.CliParseResult.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Program.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(_ClrosX64SerializerGeneratorDirectory)Program.OutputWriteResult.cs" />
    <_ClrosX64SerializerGeneratorInput Include="$(MSBuildThisFileFullPath)" />
  </ItemGroup>

  <Target Name="ValidateClrosX64SerializerGeneratorCompileClosure"
          BeforeTargets="PrepareForBuild"
          Condition="'$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)OS.X64TextSerializerGenerator.csproj'">
    <Error
      Condition="'@(Compile-&gt;'%(Identity)', '|')' != 'Amd64CoffWriter.Amd64CoffObjectDefinition.cs|Amd64CoffWriter.CoffRelocationDefinition.cs|Amd64CoffWriter.CoffSectionDefinition.cs|Amd64CoffWriter.CoffSectionLayout.cs|Amd64CoffWriter.CoffSymbolDefinition.cs|Amd64CoffWriter.CoffWriteError.cs|Amd64CoffWriter.CoffWritePlan.cs|Amd64CoffWriter.cs|CheckedReferenceBarrierThunkGenerator.cs|EhContributionCatalogGenerator.Contribution.cs|EhContributionCatalogGenerator.cs|EhContributionCatalogGenerator.Node.cs|EhContributionCatalogGenerator.Symbol.cs|ExceptionFilterThunkGenerator.cs|ExceptionHandlingThunkGenerator.cs|InstructionPublicationSerializerGenerator.cs|InterfaceDispatchThunkGenerator.cs|NormalFinallyThunkGenerator.cs|Program.CliParseResult.cs|Program.cs|Program.OutputWriteResult.cs'"
      Text="CLROS_M01_034_GENERATOR_FAILED compile_closure_mismatch actual=@(Compile-&gt;'%(Identity)', '|')" />
    <Error
      Condition="'@(ProjectReference)' != '' Or '@(Reference)' != '' Or '@(PackageReference)' != ''"
      Text="CLROS_M01_034_GENERATOR_FAILED reference_closure_mismatch project=@(ProjectReference) reference=@(Reference) package=@(PackageReference)" />
    <Error
      Condition="'@(Analyzer-&gt;'%(Filename)%(Extension)', '|')' != 'Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll|Microsoft.CodeAnalysis.NetAnalyzers.dll'"
      Text="CLROS_M01_034_GENERATOR_FAILED analyzer_closure_mismatch actual=@(Analyzer-&gt;'%(Filename)%(Extension)', '|')" />
    <Error
      Condition="'$(_ClrosX64SerializerGeneratorProjectSha256)' != '' Or '$(_ClrosX64SerializerToolsPropsSha256)' != '' Or '$(_ClrosX64SerializerRootPropsSha256)' != '' Or '$(_ClrosX64SerializerRootTargetsSha256)' != ''"
      Text="CLROS_M01_034_GENERATOR_FAILED build_input_hash_override" />
    <Error
      Condition="'$(DirectoryBuildPropsPath)' != '$([System.IO.Path]::GetFullPath(&quot;$(MSBuildThisFileDirectory)..\Directory.Build.props&quot;))' Or '$(DirectoryBuildTargetsPath)' != '$([System.IO.Path]::GetFullPath(&quot;$(MSBuildThisFileDirectory)..\..\Directory.Build.targets&quot;))' Or '$(ImportDirectoryBuildProps)' != 'true' Or '$(ImportDirectoryBuildTargets)' != 'true'"
      Text="CLROS_M01_034_GENERATOR_FAILED directory_build_import_override" />
    <Error
      Condition="'$(CustomBeforeMicrosoftCommonTargets)' != '$(MSBuildThisFileFullPath)' Or '$(CustomAfterMicrosoftCommonTargets)' != '' Or '$(CustomBeforeMicrosoftCommonProps)' != '' Or '$(CustomAfterMicrosoftCommonProps)' != '' Or '$(CustomBeforeDirectoryBuildProps)' != '' Or '$(CustomAfterDirectoryBuildProps)' != '' Or '$(CustomBeforeDirectoryBuildTargets)' != '' Or '$(CustomAfterDirectoryBuildTargets)' != '' Or '$(CustomBeforeMicrosoftCSharpTargets)' != '' Or '$(CustomAfterMicrosoftCSharpTargets)' != '' Or '$(CustomBeforeMicrosoftCommonCrossTargetingTargets)' != '' Or '$(CustomAfterMicrosoftCommonCrossTargetingTargets)' != ''"
      Text="CLROS_M01_034_GENERATOR_FAILED custom_import_override" />
    <Error
      Condition="'$(BeforeMicrosoftNETSdkTargets)' != '' Or '$(AfterMicrosoftNETSdkTargets)' != '' Or '$(LanguageTargets)' != '$(MSBuildToolsPath)\Microsoft.CSharp.targets' Or '$(CSharpTargetsPath)' != '$(MSBuildToolsPath)\Microsoft.CSharp.CurrentVersion.targets' Or '$(CommonTargetsPath)' != '$(MSBuildToolsPath)\Microsoft.Common.CurrentVersion.targets' Or '$(ImportNuGetBuildTasksPackTargetsFromSdk)' != 'false' Or '$(NuGetBuildTasksPackTargets)' != ''"
      Text="CLROS_M01_034_GENERATOR_FAILED sdk_import_override" />
    <Error
      Condition="'$(MSBuildSDKsPath)' != '$(_ClrosX64SerializerCanonicalSdksPath)' Or '$(MSBuildExtensionsPath)' != '$(_ClrosX64SerializerCanonicalMsbuildExtensionsPath)' Or '$(MSBuildUserExtensionsPath)' != '$(_ClrosX64SerializerCanonicalDisabledUserExtensions)' Or '$(UseSharedCompilation)' != 'false'"
      Text="CLROS_M01_034_GENERATOR_FAILED sdk_path_isolation_override" />
    <Error
      Condition="'$(ImportByWildcardBeforeMicrosoftCommonProps)' != 'false' Or '$(ImportByWildcardAfterMicrosoftCommonProps)' != 'false' Or '$(ImportUserLocationsByWildcardBeforeMicrosoftCommonProps)' != 'false' Or '$(ImportUserLocationsByWildcardAfterMicrosoftCommonProps)' != 'false' Or '$(ImportByWildcardBeforeMicrosoftCommonTargets)' != 'false' Or '$(ImportByWildcardAfterMicrosoftCommonTargets)' != 'false' Or '$(ImportUserLocationsByWildcardBeforeMicrosoftCommonTargets)' != 'false' Or '$(ImportUserLocationsByWildcardAfterMicrosoftCommonTargets)' != 'false' Or '$(ImportByWildcardBeforeMicrosoftCSharpTargets)' != 'false' Or '$(ImportByWildcardAfterMicrosoftCSharpTargets)' != 'false' Or '$(ImportUserLocationsByWildcardBeforeMicrosoftCSharpTargets)' != 'false' Or '$(ImportUserLocationsByWildcardAfterMicrosoftCSharpTargets)' != 'false' Or '$(ImportByWildcardBeforeMicrosoftCommonCrossTargetingTargets)' != 'false' Or '$(ImportByWildcardAfterMicrosoftCommonCrossTargetingTargets)' != 'false'"
      Text="CLROS_M01_034_GENERATOR_FAILED wildcard_import_isolation_override" />
    <Error
      Condition="Exists('$(MSBuildUserExtensionsPath)')"
      Text="CLROS_M01_034_GENERATOR_FAILED user_extensions_path_exists path=$(MSBuildUserExtensionsPath)" />
    <Error
      Condition="'$(MSBuildProjectExtensionsPath)' != '$(BaseIntermediateOutputPath)' Or '$(RestoreOutputPath)' != '$(BaseIntermediateOutputPath)' Or '$(ProjectAssetsFile)' != '$(BaseIntermediateOutputPath)project.assets.json' Or '$(ImportProjectExtensionProps)' != 'true' Or '$(ImportProjectExtensionTargets)' != 'true' Or '$(RestoreUseCustomAfterTargets)' != 'false' Or '$(RestoreForceEvaluate)' != 'true'"
      Text="CLROS_M01_034_GENERATOR_FAILED project_extensions_path_override" />
    <GetFileHash
      Files="$(MSBuildProjectFullPath)"
      Algorithm="SHA256"
      HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ClrosX64SerializerGeneratorProjectSha256" />
    </GetFileHash>
    <GetFileHash
      Files="$(MSBuildThisFileDirectory)..\Directory.Build.props"
      Algorithm="SHA256"
      HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ClrosX64SerializerToolsPropsSha256" />
    </GetFileHash>
    <GetFileHash
      Files="$(MSBuildThisFileDirectory)..\..\Directory.Build.props"
      Algorithm="SHA256"
      HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ClrosX64SerializerRootPropsSha256" />
    </GetFileHash>
    <GetFileHash
      Files="$(MSBuildThisFileDirectory)..\..\Directory.Build.targets"
      Algorithm="SHA256"
      HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ClrosX64SerializerRootTargetsSha256" />
    </GetFileHash>
    <Error
      Condition="'$(_ClrosX64SerializerGeneratorProjectSha256)' != '45D4178D3562597F2094EE23C561A4864EED6EDAE0DE8BF183A25A5DB7FA24C2' Or '$(_ClrosX64SerializerToolsPropsSha256)' != '44B8268EA6934335DBC79FEF47C1CE1FDEE49393C929C92E322417B14AA321AE' Or '$(_ClrosX64SerializerRootPropsSha256)' != 'DF8A0D794DB73060124F5134EB930DCDBF6EE526C2410227F0C668AB6D10C5E5' Or '$(_ClrosX64SerializerRootTargetsSha256)' != '85AFD90F9DD0F550B6A3C6AD71D28BF714A8C930158DB872F8DA5D316889931A'"
      Text="CLROS_M01_034_GENERATOR_FAILED build_input_hash_mismatch" />
  </Target>

  <Target Name="TrackClrosX64InstructionPublicationSerializerOutput"
          BeforeTargets="_CleanGetCurrentAndPriorFileWrites"
          Condition="'$(NativeIntermediateOutputPath)' != ''">
    <PropertyGroup>
      <_ClrosX64SerializerTrackingPathIsRooted>$([System.IO.Path]::IsPathRooted('$(NativeIntermediateOutputPath)'))</_ClrosX64SerializerTrackingPathIsRooted>
      <_ClrosX64SerializerTrackingRootCandidate
        Condition="'$(_ClrosX64SerializerTrackingPathIsRooted)' == 'True'">$([System.IO.Path]::GetFullPath('$(NativeIntermediateOutputPath)'))</_ClrosX64SerializerTrackingRootCandidate>
      <_ClrosX64SerializerTrackingRootCandidate
        Condition="'$(_ClrosX64SerializerTrackingPathIsRooted)' != 'True'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(NativeIntermediateOutputPath)'))</_ClrosX64SerializerTrackingRootCandidate>
      <_ClrosX64SerializerTrackingRoot>$([System.IO.Path]::GetFullPath('$(_ClrosX64SerializerTrackingRootCandidate)\.'))</_ClrosX64SerializerTrackingRoot>
      <_ClrosX64SerializerTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.InstructionPublication.obj</_ClrosX64SerializerTrackedObject>
      <_ClrosCheckedReferenceTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.CheckedReferenceBarriers.obj</_ClrosCheckedReferenceTrackedObject>
      <_ClrosInterfaceDispatchTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.InterfaceDispatch.obj</_ClrosInterfaceDispatchTrackedObject>
      <_ClrosSimpleCatchTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.SimpleThrowCatch.obj</_ClrosSimpleCatchTrackedObject>
      <_ClrosFrameDispatchTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.FrameDispatch.obj</_ClrosFrameDispatchTrackedObject>
      <_ClrosConstructorFailureTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.ConstructorFailure.obj</_ClrosConstructorFailureTrackedObject>
      <_ClrosFilteredCatchTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.FilteredCatch.obj</_ClrosFilteredCatchTrackedObject>
      <_ClrosFilterInvokeTrackedObject>$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.FilterInvoke.obj</_ClrosFilterInvokeTrackedObject>
      <_ClrosX64SerializerTrackedToolRoot>$(_ClrosX64SerializerTrackingRoot)\clros-x64-serializer-tool\</_ClrosX64SerializerTrackedToolRoot>
    </PropertyGroup>
    <Error
      Condition="$([System.IO.Path]::IsPathRooted('$(NativeIntermediateOutputPath)')) And '$(_ClrosX64SerializerTrackingRootCandidate)' != '$([System.IO.Path]::GetFullPath(&quot;$(NativeIntermediateOutputPath)&quot;))'"
      Text="CLROS_M01_034_GENERATOR_FAILED tracking_root_override" />
    <Error
      Condition="!$([System.IO.Path]::IsPathRooted('$(NativeIntermediateOutputPath)')) And '$(_ClrosX64SerializerTrackingRootCandidate)' != '$([System.IO.Path]::GetFullPath(&quot;$(MSBuildProjectDirectory)\$(NativeIntermediateOutputPath)&quot;))'"
      Text="CLROS_M01_034_GENERATOR_FAILED tracking_root_override" />
    <Error
      Condition="'$(_ClrosX64SerializerTrackingRoot)' != '$([System.IO.Path]::GetFullPath(&quot;$(_ClrosX64SerializerTrackingRootCandidate)\.&quot;))'"
      Text="CLROS_M01_034_GENERATOR_FAILED tracking_root_override" />
    <Error
      Condition="'$(_ClrosX64SerializerTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.InstructionPublication.obj'"
      Text="CLROS_M01_034_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosX64SerializerTrackedToolRoot)' != '$(_ClrosX64SerializerTrackingRoot)\clros-x64-serializer-tool\'"
      Text="CLROS_M01_034_GENERATOR_FAILED tracking_tool_root_override" />
    <Error
      Condition="'$(_ClrosCheckedReferenceTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.CheckedReferenceBarriers.obj'"
      Text="CLROS_M04_010_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosInterfaceDispatchTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.InterfaceDispatch.obj'"
      Text="CLROS_M04_016_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosSimpleCatchTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.SimpleThrowCatch.obj'"
      Text="CLROS_M04_021_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosFrameDispatchTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.FrameDispatch.obj'"
      Text="CLROS_M04_021_FRAME_DISPATCH_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosConstructorFailureTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.ConstructorFailure.obj'"
      Text="CLROS_M04_021_CONSTRUCTOR_FAILURE_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosFilteredCatchTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.FilteredCatch.obj'"
      Text="CLROS_M04_021_FILTERED_CATCH_GENERATOR_FAILED tracking_object_override" />
    <Error
      Condition="'$(_ClrosFilterInvokeTrackedObject)' != '$(_ClrosX64SerializerTrackingRoot)\CLROS.X64.FilterInvoke.obj'"
      Text="CLROS_M04_021_FILTER_INVOKE_GENERATOR_FAILED tracking_object_override" />
    <ItemGroup>
      <FileWrites Include="$(_ClrosInterfaceDispatchTrackedObject)" />
      <FileWrites Include="$(_ClrosSimpleCatchTrackedObject)" />
      <FileWrites Include="$(_ClrosFrameDispatchTrackedObject)" />
      <FileWrites Include="$(_ClrosConstructorFailureTrackedObject)" />
      <FileWrites Include="$(_ClrosFilteredCatchTrackedObject)" />
      <FileWrites Include="$(_ClrosFilterInvokeTrackedObject)" />
      <FileWrites Include="$(_ClrosX64SerializerTrackedObject)" />
      <FileWrites Include="$(_ClrosCheckedReferenceTrackedObject)" />
      <FileWrites
        Include="$(_ClrosX64SerializerTrackedToolRoot)**\*"
        Condition="Exists('$(_ClrosX64SerializerTrackedToolRoot)')" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveClrosX64InstructionPublicationSerializerToolOutput"
          AfterTargets="CoreClean"
          DependsOnTargets="TrackClrosX64InstructionPublicationSerializerOutput"
          Condition="'$(NativeIntermediateOutputPath)' != ''">
    <RemoveDir
      Directories="$(_ClrosX64SerializerTrackedToolRoot)"
      Condition="Exists('$(_ClrosX64SerializerTrackedToolRoot)')" />
    <Error
      Condition="Exists('$(_ClrosX64SerializerTrackedToolRoot)')"
      Text="CLROS_M01_034_GENERATOR_FAILED clean_tool_root_not_removed path=$(_ClrosX64SerializerTrackedToolRoot)" />
  </Target>

  <Target Name="IntegrateClrosX64InstructionPublicationSerializer"
          AfterTargets="RemoveNativeAotRuntimeLibraries"
          BeforeTargets="LinkNative">
    <Error
      Condition="'$(_ClrosX64SerializerGeneratorDirectory)' != '$(MSBuildThisFileDirectory)'"
      Text="CLROS_M01_034_GENERATOR_FAILED generator_directory_override" />
    <Error
      Condition="'$(_ClrosX64SerializerGeneratorProject)' != '$(MSBuildThisFileDirectory)OS.X64TextSerializerGenerator.csproj'"
      Text="CLROS_M01_034_GENERATOR_FAILED generator_project_override" />
    <Error
      Condition="'$(_ClrosX64SerializerObjectName)' != 'CLROS.X64.InstructionPublication.obj'"
      Text="CLROS_M01_034_GENERATOR_FAILED object_name_override" />
    <Error
      Condition="'$(_ClrosCheckedReferenceObjectName)' != 'CLROS.X64.CheckedReferenceBarriers.obj' Or '$(_ClrosCheckedReferenceActualSha256)' != ''"
      Text="CLROS_M04_010_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosInterfaceDispatchObjectName)' != 'CLROS.X64.InterfaceDispatch.obj' Or '$(_ClrosInterfaceDispatchActualSha256)' != ''"
      Text="CLROS_M04_016_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosSimpleCatchObjectName)' != 'CLROS.X64.SimpleThrowCatch.obj' Or '$(_ClrosSimpleCatchActualSha256)' != ''"
      Text="CLROS_M04_021_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosSingleFinallyObjectName)' != 'CLROS.X64.SingleFinallyCatch.obj' Or '$(_ClrosSingleFinallyActualSha256)' != ''"
      Text="CLROS_M04_021_FINALLY_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosNestedFinallyObjectName)' != 'CLROS.X64.NestedFinallyCatch.obj' Or '$(_ClrosNestedFinallyActualSha256)' != ''"
      Text="CLROS_M04_021_NESTED_FINALLY_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosFrameDispatchObjectName)' != 'CLROS.X64.FrameDispatch.obj' Or '$(_ClrosFrameDispatchActualSha256)' != ''"
      Text="CLROS_M04_021_FRAME_DISPATCH_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosConstructorFailureObjectName)' != 'CLROS.X64.ConstructorFailure.obj' Or '$(_ClrosConstructorFailureActualSha256)' != ''"
      Text="CLROS_M04_021_CONSTRUCTOR_FAILURE_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosFilteredCatchObjectName)' != 'CLROS.X64.FilteredCatch.obj' Or '$(_ClrosFilteredCatchActualSha256)' != ''"
      Text="CLROS_M04_021_FILTERED_CATCH_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosFilterInvokeObjectName)' != 'CLROS.X64.FilterInvoke.obj' Or '$(_ClrosFilterInvokeActualSha256)' != ''"
      Text="CLROS_M04_021_FILTER_INVOKE_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosRethrowOuterObjectName)' != 'CLROS.X64.RethrowOuter.obj' Or '$(_ClrosRethrowOuterActualSha256)' != ''"
      Text="CLROS_M04_021_RETHROW_OUTER_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(_ClrosRethrowInnerObjectName)' != 'CLROS.X64.RethrowInner.obj' Or '$(_ClrosRethrowInnerActualSha256)' != ''"
      Text="CLROS_M04_021_RETHROW_INNER_GENERATOR_FAILED object_contract_override" />
    <Error
      Condition="'$(ClrosX64InstructionPublicationSymbol)' != 'CLROS_X64_SerializeInstructionPublication'"
      Text="CLROS_M01_034_GENERATOR_FAILED symbol_override" />
    <Error
      Condition="'$(ClrosX64InstructionPublicationObjectBytes)' != '336'"
      Text="CLROS_M01_034_GENERATOR_FAILED object_size_override" />
    <Error
      Condition="'$(ClrosX64InstructionPublicationObjectSha256)' != 'DA97E50C95E479541B65EB3F96D9C6DED163735857650BEE9416324086D55C7B'"
      Text="CLROS_M01_034_GENERATOR_FAILED object_hash_override" />
    <Error
      Condition="'$(_ClrosX64SerializerActualSha256)' != ''"
      Text="CLROS_M01_034_GENERATOR_FAILED actual_hash_override" />
    <Error
      Condition="'$(NativeIntermediateOutputPath)' == ''"
      Text="CLROS_M01_034_GENERATOR_FAILED native_intermediate_output_path_missing" />
    <Error
      Condition="'$(Configuration)' == ''"
      Text="CLROS_M01_034_GENERATOR_FAILED configuration_missing" />
    <PropertyGroup>
      <_ClrosX64SerializerNativeIntermediatePathIsRooted>$([System.IO.Path]::IsPathRooted('$(NativeIntermediateOutputPath)'))</_ClrosX64SerializerNativeIntermediatePathIsRooted>
      <_ClrosX64SerializerNativeIntermediateRootCandidate
        Condition="'$(_ClrosX64SerializerNativeIntermediatePathIsRooted)' == 'True'">$([System.IO.Path]::GetFullPath('$(NativeIntermediateOutputPath)'))</_ClrosX64SerializerNativeIntermediateRootCandidate>
      <_ClrosX64SerializerNativeIntermediateRootCandidate
        Condition="'$(_ClrosX64SerializerNativeIntermediatePathIsRooted)' != 'True'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(NativeIntermediateOutputPath)'))</_ClrosX64SerializerNativeIntermediateRootCandidate>
      <_ClrosX64SerializerNativeIntermediateRoot>$([System.IO.Path]::GetFullPath('$(_ClrosX64SerializerNativeIntermediateRootCandidate)\.'))</_ClrosX64SerializerNativeIntermediateRoot>
      <_ClrosX64SerializerToolRoot>$(_ClrosX64SerializerNativeIntermediateRoot)\clros-x64-serializer-tool\</_ClrosX64SerializerToolRoot>
      <_ClrosX64SerializerToolIntermediate>$(_ClrosX64SerializerToolRoot)obj\</_ClrosX64SerializerToolIntermediate>
      <_ClrosX64SerializerToolOutput>$(_ClrosX64SerializerToolRoot)bin\$(Configuration)\net11.0\</_ClrosX64SerializerToolOutput>
      <_ClrosX64SerializerToolExecutable>$(_ClrosX64SerializerToolOutput)OS.X64TextSerializerGenerator.exe</_ClrosX64SerializerToolExecutable>
      <_ClrosX64SerializerToolAssetsFile>$(_ClrosX64SerializerToolIntermediate)project.assets.json</_ClrosX64SerializerToolAssetsFile>
      <_ClrosX64SerializerToolDisabledUserExtensions>$(_ClrosX64SerializerToolIntermediate)disabled-user-extensions</_ClrosX64SerializerToolDisabledUserExtensions>
      <ClrosX64InstructionPublicationObject>$(_ClrosX64SerializerNativeIntermediateRoot)\$(_ClrosX64SerializerObjectName)</ClrosX64InstructionPublicationObject>
