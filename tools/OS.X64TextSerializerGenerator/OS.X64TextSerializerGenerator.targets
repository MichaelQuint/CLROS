      <NativeLibrary Include="$(_ClrosFrameDispatchObject)" />
      <LinkerArg Include="&quot;$(_ClrosFrameDispatchObject)&quot;" />
      <LinkerArg Include="/INCLUDE:RhpThrowEx" />
      <LinkerArg Include="/INCLUDE:CLROS_Frame_CatcherClauses" />
      <LinkerArg Include="/INCLUDE:CLROS_Frame_MiddleClauses" />
      <FileWrites Include="$(_ClrosFrameDispatchObject)" />
    </ItemGroup>
    <ItemGroup Condition="'$(EnableM04ConstructorFailureProbe)' == 'true'">
      <NativeLibrary Include="$(_ClrosConstructorFailureObject)" />
      <LinkerArg Include="&quot;$(_ClrosConstructorFailureObject)&quot;" />
      <LinkerArg Include="/INCLUDE:RhpThrowEx" />
      <LinkerArg Include="/INCLUDE:CLROS_CctorFailure_InvokeClauses" />
      <LinkerArg Include="/INCLUDE:CLROS_CctorFailure_OuterClauses" />
      <FileWrites Include="$(_ClrosConstructorFailureObject)" />
    </ItemGroup>
    <ItemGroup Condition="'$(EnableM04FilteredCatchProbe)' == 'true'">
      <NativeLibrary Include="$(_ClrosFilteredCatchObject)" />
      <LinkerArg Include="&quot;$(_ClrosFilteredCatchObject)&quot;" />
      <LinkerArg Include="/INCLUDE:RhpThrowEx" />
      <LinkerArg Include="/INCLUDE:CLROS_Filter_Clauses" />
      <LinkerArg Include="/INCLUDE:RhTypeCast_IsInstanceOfClass" />
      <FileWrites Include="$(_ClrosFilteredCatchObject)" />
    </ItemGroup>
    <ItemGroup Condition="'$(EnableM04FilteredCatchProbe)' == 'true'">
      <NativeLibrary Include="$(_ClrosFilterInvokeObject)" />
      <LinkerArg Include="&quot;$(_ClrosFilterInvokeObject)&quot;" />
      <LinkerArg Include="/INCLUDE:CLROS_Filter_Invoke" />
      <FileWrites Include="$(_ClrosFilterInvokeObject)" />
    </ItemGroup>
    <Exec Condition="'$(EnableM04RethrowProbe)' == 'true'"
      Command="&quot;$(_ClrosX64SerializerToolExecutable)&quot; --rethrow-outer --output-root &quot;$(_ClrosX64SerializerNativeIntermediateRoot)&quot; --output-file &quot;CLROS.X64.RethrowOuter.obj&quot;"
      ConsoleToMSBuild="true" IgnoreExitCode="false" Timeout="60000" />
    <Error Condition="'$(EnableM04RethrowProbe)' == 'true' And !Exists('$(_ClrosRethrowOuterObject)')"
      Text="CLROS_M04_021_RETHROW_OUTER_GENERATOR_FAILED object_missing" />
    <GetFileHash Condition="'$(EnableM04RethrowProbe)' == 'true'"
      Files="$(_ClrosRethrowOuterObject)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ClrosRethrowOuterActualSha256" />
    </GetFileHash>
    <Error Condition="'$(EnableM04RethrowProbe)' == 'true' And '$(_ClrosRethrowOuterActualSha256)' != '635C903FF77EE3C7DE3D1EDCE3E6F015DDEF204454A50432DFCF9692686E337B'"
      Text="CLROS_M04_021_RETHROW_OUTER_GENERATOR_FAILED object_hash_mismatch" />
    <ItemGroup Condition="'$(EnableM04RethrowProbe)' == 'true'">
      <NativeLibrary Include="$(_ClrosRethrowOuterObject)" />
      <LinkerArg Include="&quot;$(_ClrosRethrowOuterObject)&quot;" />
      <LinkerArg Include="/INCLUDE:RhpRethrow" />
      <LinkerArg Include="/INCLUDE:CLROS_Rethrow_OuterClauses" />
      <FileWrites Include="$(_ClrosRethrowOuterObject)" />
    </ItemGroup>
    <Exec Condition="'$(EnableM04RethrowProbe)' == 'true'"
      Command="&quot;$(_ClrosX64SerializerToolExecutable)&quot; --rethrow-inner --output-root &quot;$(_ClrosX64SerializerNativeIntermediateRoot)&quot; --output-file &quot;CLROS.X64.RethrowInner.obj&quot;"
      ConsoleToMSBuild="true" IgnoreExitCode="false" Timeout="60000" />
    <Error Condition="'$(EnableM04RethrowProbe)' == 'true' And !Exists('$(_ClrosRethrowInnerObject)')"
      Text="CLROS_M04_021_RETHROW_INNER_GENERATOR_FAILED object_missing" />
    <GetFileHash Condition="'$(EnableM04RethrowProbe)' == 'true'"
      Files="$(_ClrosRethrowInnerObject)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_ClrosRethrowInnerActualSha256" />
    </GetFileHash>
    <Error Condition="'$(EnableM04RethrowProbe)' == 'true' And '$(_ClrosRethrowInnerActualSha256)' != 'D30D37F5AD93A70A66D2ED2E69A184A75DB903C5A1D69C4E31571569016E7A10'"
      Text="CLROS_M04_021_RETHROW_INNER_GENERATOR_FAILED object_hash_mismatch" />
    <ItemGroup Condition="'$(EnableM04RethrowProbe)' == 'true'">
      <NativeLibrary Include="$(_ClrosRethrowInnerObject)" />
      <LinkerArg Include="&quot;$(_ClrosRethrowInnerObject)&quot;" />
      <LinkerArg Include="/INCLUDE:RhpThrowEx" />
      <LinkerArg Include="/INCLUDE:CLROS_Rethrow_InnerClauses" />
      <FileWrites Include="$(_ClrosRethrowInnerObject)" />
    </ItemGroup>
  </Target>

  <!-- The input pair is emitted by this exact ILC compilation, before LinkNative. -->
  <Target Name="IntegrateClrosEhContributionCatalog" BeforeTargets="LinkNative"
    DependsOnTargets="IlcCompile;IntegrateClrosX64InstructionPublicationSerializer"
    Condition="'$(EnableM04EhCatalogProbe)' == 'true' Or '$(EnableM04NormalFinallyProbe)' == 'true'">
    <Error Condition="'$(IlcGenerateMapFile)' != 'true' Or !Exists('$(NativeObject)') Or !Exists('$(_ClrosX64SerializerNativeIntermediateRoot)\OS.map.xml')"
      Text="CLROS_M04_EH_CATALOG_FAILED original_compiler_inputs_missing" />
    <Exec Condition="'$(EnableM04NormalFinallyProbe)' != 'true'" Command="&quot;$(_ClrosX64SerializerToolExecutable)&quot; --eh-contribution-catalog --object &quot;$(NativeObject)&quot; --map &quot;$(_ClrosX64SerializerNativeIntermediateRoot)\OS.map.xml&quot; --output &quot;$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.EhCatalog.obj&quot;"
      ConsoleToMSBuild="true" IgnoreExitCode="false" Timeout="60000" />
    <Exec Condition="'$(EnableM04NormalFinallyProbe)' == 'true'" Command="&quot;$(_ClrosX64SerializerToolExecutable)&quot; --eh-contribution-catalog --object &quot;$(NativeObject)&quot; --map &quot;$(_ClrosX64SerializerNativeIntermediateRoot)\OS.map.xml&quot; --output &quot;$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.EhCatalog.obj&quot; --method OS_OS_Runtime_RhpNewFastAllocation__NormalCatcher"
      ConsoleToMSBuild="true" IgnoreExitCode="false" Timeout="60000" />
    <ItemGroup>
      <NativeLibrary Include="$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.EhCatalog.obj" />
      <LinkerArg Include="&quot;$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.EhCatalog.obj&quot;" />
      <LinkerArg Include="/INCLUDE:CLROS_Eh_CatalogStart" />
      <LinkerArg Include="/INCLUDE:CLROS_Eh_CatalogEnd" />
      <LinkerArg Include="/INCLUDE:CLROS_Eh_Contributions" />
      <LinkerArg Include="/INCLUDE:CLROS_Eh_ContributionsEnd" />
      <FileWrites Include="$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.EhCatalog.obj" />
    </ItemGroup>
  </Target>

  <Target Name="IntegrateClrosNormalFinally" BeforeTargets="LinkNative"
    DependsOnTargets="IlcCompile;IntegrateClrosX64InstructionPublicationSerializer"
    Condition="'$(EnableM04NormalFinallyProbe)' == 'true'">
    <Exec Command="&quot;$(_ClrosX64SerializerToolExecutable)&quot; --normal-finally --output-root &quot;$(_ClrosX64SerializerNativeIntermediateRoot)&quot; --output-file CLROS.X64.NormalFinally.obj"
      ConsoleToMSBuild="true" IgnoreExitCode="false" Timeout="60000" />
    <ItemGroup>
      <NativeLibrary Include="$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.NormalFinally.obj" />
      <LinkerArg Include="&quot;$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.NormalFinally.obj&quot;" />
      <LinkerArg Include="/INCLUDE:RhpThrowEx" />
      <LinkerArg Include="/INCLUDE:CLROS_NormalFinally_Clauses" />
      <LinkerArg Include="/INCLUDE:RhTypeCast_IsInstanceOfException" />
      <FileWrites Include="$(_ClrosX64SerializerNativeIntermediateRoot)\CLROS.X64.NormalFinally.obj" />
    </ItemGroup>
  </Target>
</Project>
