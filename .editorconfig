root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false
csharp_style_allow_embedded_statements_on_same_line_experimental = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_style_namespace_declarations = file_scoped:suggestion
# Simple guards/loops may omit braces, as in the reviewed LinuxPipe example.
# Existing braces and member order are not rewritten by policy.
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE2001.severity = warning
dotnet_sort_system_directives_first = true
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case
dotnet_naming_rule.parameters_camel_case.severity = suggestion
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_style.camel_case.capitalization = camel_case

# Upstream sources and generated/retained outputs are not refactor inputs.
[{references,artifacts,**/bin,**/obj}/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[*.md]
trim_trailing_whitespace = false
